{
    "name": "iazaran/php-mvc",
    "description": "Pure PHP Composer based MVC Framework",
    "type": "project",
    "authors": [
        {
            "name": "Ismael Azaran",
            "email": "eazaran@gmail.com"
        }
    ],
    "license": "MIT",
    "autoload": {
        "files": [
            "env.php",
            "src/migrations.php",
            "src/routes.php"
        ],
        "classmap": [
            "src/"
        ]
    },
    "config": {
        "platform": {
            "php": "8.5.6"
        }
    },
    "require": {
        "php": "^8.5.6",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-memcached": "*",
        "ext-sockets": "*",
        "ext-curl": "*",
        "phpmailer/phpmailer": "^7.1.0"
    }
}
